{
  "name": "dr-huckle",
  "version": "2.1.0",
  "homepage": "https://huckle.studio/",
  "packageManager": "pnpm@10.28.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "validate:content": "tsx scripts/validate-content.ts",
    "build": "pnpm validate:content && next build --turbopack && cp CNAME build/CNAME",
    "start": "pnpm exec serve build",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "^30.0.1",
    "serve": "^14.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
